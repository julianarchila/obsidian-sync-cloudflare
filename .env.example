# Homebase server configuration. Copy to .env and fill in.

# Shared secret between the Worker and your devices. Generate one with: openssl rand -hex 32
OSCF_TOKEN=

# Your Worker URL, printed by `bun run deploy` (used by `bun run smoke` and the e2e test).
OSCF_URL=

# Optional: pin deploys to this Cloudflare account id.
CLOUDFLARE_ACCOUNT_ID=

# Optional: how many days old file versions are kept (default 365).
# OSCF_RETENTION_DAYS=365
