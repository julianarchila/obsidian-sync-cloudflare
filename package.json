{
  "name": "obsidian-sync-cloudflare",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "ALCHEMY_STATE=local alchemy dev",
    "deploy": "alchemy deploy",
    "plan": "alchemy plan",
    "destroy": "alchemy destroy",
    "check": "bun run typecheck && bun run test && bun run check:bundle",
    "typecheck": "tsc -p packages/protocol && tsc -p packages/server && tsc -p packages/plugin && tsc -p packages/cli && tsc -p . && tsc -p tsconfig.test.json",
    "test": "bun test packages",
    "check:bundle": "bun scripts/check-bundle.ts",
    "plugin:build": "bun run --cwd packages/plugin build",
    "plugin:dev": "bun run --cwd packages/plugin dev",
    "smoke": "bun scripts/smoke.ts",
    "smoke:dev": "OSCF_URL=http://localhost:1337 bun scripts/smoke.ts",
    "e2e": "bun scripts/e2e-obsidian.ts",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/domain": "2.0.0-beta.85",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@oscf/server": "workspace:*",
    "@types/bun": "^1.4.4",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "typescript": "^5.9.3"
  }
}
